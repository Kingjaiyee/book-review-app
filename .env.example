# Copy to .env on the server, fill in real values, chmod 600. Never commit .env.

# MySQL (the backend reuses these for DB_NAME, DB_USER and DB_PASS)
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=book_review_db
MYSQL_USER=bookreview_user
MYSQL_PASSWORD=change_me

# Backend
JWT_SECRET=change_me

# Browser-facing addresses (VM public IP; no trailing slash)
ALLOWED_ORIGINS=http://<VM_PUBLIC_IP>:3000
NEXT_PUBLIC_API_URL=http://<VM_PUBLIC_IP>:3001
